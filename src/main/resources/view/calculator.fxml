<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.CalculatorController">

    <Label fx:id="display" text="0" styleClass="display"
           maxWidth="Infinity" alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS"/>

    <GridPane hgap="12" vgap="12" prefHeight="420" VBox.vgrow="ALWAYS">
        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints percentHeight="20" vgrow="ALWAYS"/>
            <RowConstraints percentHeight="20" vgrow="ALWAYS"/>
            <RowConstraints percentHeight="20" vgrow="ALWAYS"/>
            <RowConstraints percentHeight="20" vgrow="ALWAYS"/>
            <RowConstraints percentHeight="20" vgrow="ALWAYS"/>
        </rowConstraints>

        <Button text="C" styleClass="calc-button, function" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Button text="±" styleClass="calc-button, function" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Button text="\%" styleClass="calc-button, function" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <Button text="÷" styleClass="calc-button, operator" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Button text="7" styleClass="calc-button, digit" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Button text="8" styleClass="calc-button, digit" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Button text="9" styleClass="calc-button, digit" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <Button text="×" styleClass="calc-button, operator" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <Button text="4" styleClass="calc-button, digit" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Button text="5" styleClass="calc-button, digit" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Button text="6" styleClass="calc-button, digit" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <Button text="-" styleClass="calc-button, operator" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="3" GridPane.rowIndex="2"/>

        <Button text="1" styleClass="calc-button, digit" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Button text="2" styleClass="calc-button, digit" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Button text="3" styleClass="calc-button, digit" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="2" GridPane.rowIndex="3"/>
        <Button text="+" styleClass="calc-button, operator" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="3" GridPane.rowIndex="3"/>

        <Button text="0" styleClass="calc-button, digit, zero" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2"/>
        <Button text="." styleClass="calc-button, digit" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="2" GridPane.rowIndex="4"/>
        <Button text="=" styleClass="calc-button, operator" onAction="#onButtonClick"
                maxWidth="Infinity" maxHeight="Infinity" focusTraversable="false"
                GridPane.columnIndex="3" GridPane.rowIndex="4"/>

    </GridPane>
</VBox>
